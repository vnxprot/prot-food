NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Required for server-side Admin writes (add/edit quán and import nguồn dữ liệu).
# Keep this secret server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Set as a Production secret in Vercel for the daily Supabase read check.
CRON_SECRET=YOUR_RANDOM_CRON_SECRET
